# ConectaBem.net — Configuração de ambiente
# Copie este arquivo para `.env` e ajuste os valores para o seu ambiente.

# --- Aplicação ---
APP_PORT=3000
APP_ENV=development

# Segredo usado para assinar a sessão (substitua por um valor aleatório)
# Usado a partir da Sprint 1 (módulo de autenticação).
SESSION_SECRET=troque-por-um-segredo-aleatorio

# --- Banco de dados principal (dev) ---
# DB_HOST / DB_PORT = usados pelo app DENTRO do container (rede interna), sempre 3306.
DB_HOST=db
DB_PORT=3306
DB_NAME=conectabem
DB_USER=conectabem
DB_PASSWORD=conectabem_dev

# --- Portas publicadas no host (para acessar via localhost/Adminer) ---
# Usamos 3307 para o db e 3308 para o db-test porque a 3306 costuma estar ocupada
# por um MySQL/MariaDB local. Dentro do container o MySQL continua na 3306.
DB_EXPOSE_PORT=3307
DB_TEST_EXPOSE_PORT=3308

# --- Banco de dados de teste ---
# Usados por `npm test` (executado no host) para conectar ao contêiner db-test,
# publicado na porta host DB_TEST_EXPOSE_PORT (default 3308).
DB_TEST_HOST=localhost
DB_TEST_PORT=3308
DB_TEST_NAME=conectabem_test
DB_TEST_USER=conectabem_test
DB_TEST_PASSWORD=conectabem_test_dev

# --- Credencial raiz do MySQL (usada pelo db e db-test na inicialização) ---
MYSQL_ROOT_PASSWORD=root_dev_somente

# --- Seed do usuário administrador ---
# Senha inicial do administrador (troque em produção). O e-mail é admin@conectabem.net.
ADMIN_PASSWORD=admin123

# --- E-mail / SMTP (RF_03 — recuperação de senha) ---
# Desenvolvimento: o docker-compose.yml sobe o Mailhog (SMTP em 1025, caixa de
# entrada em http://localhost:8025). Produção: aponte para um provedor real
# (ver docs/deploy.md).
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=ConectaBem <no-reply@conectabem.net>

# URL pública da aplicação (usada nos links dos e-mails).
APP_BASE_URL=http://localhost:3000

# --- Produção (docker-compose.prod.yml) ---
# Domínio publicado (Let's Encrypt exige DNS apontado para o servidor).
# Em teste local, use DOMAIN=localhost (certificado autoassinado do Caddy).
DOMAIN=localhost
ACME_EMAIL=admin@conectabem.net

# Diretório dos dumps diários do backup (scripts/backup.sh). Default: ./backups
# BACKUP_DIR=/var/backups/conectabem