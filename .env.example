# ConectaBem.net — Configuração de ambiente
# Copie este arquivo para `.env` e ajuste os valores para o seu ambiente.

# --- Aplicação ---
APP_PORT=3000
APP_ENV=development

# Segredo usado para assinar a sessão (substitua por um valor aleatório)
# Usado a partir da Sprint 1 (módulo de autenticação).
SESSION_SECRET=troque-por-um-segredo-aleatorio

# --- Banco de dados principal (dev) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=conectabem
DB_USER=conectabem
DB_PASSWORD=conectabem_dev

# --- Banco de dados de teste ---
DB_TEST_HOST=db-test
DB_TEST_PORT=3306
DB_TEST_NAME=conectabem_test
DB_TEST_USER=conectabem_test
DB_TEST_PASSWORD=conectabem_test_dev

# --- Credencial raiz do MySQL (usada pelo db e db-test na inicialização) ---
MYSQL_ROOT_PASSWORD=root_dev_somente

# --- Seed do usuário administrador ---
# Senha inicial do administrador (troque em produção). O e-mail é admin@conectabem.net.
ADMIN_PASSWORD=admin123