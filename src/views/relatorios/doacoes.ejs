<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Relatório de Doações</h1>
  <div class="d-flex gap-2">
    <a href="/relatorios/doacoes?formato=pdf<%= qs %>" class="btn btn-outline-danger btn-sm">Exportar PDF</a>
    <a href="/relatorios/doacoes?formato=xlsx<%= qs %>" class="btn btn-outline-success btn-sm">Exportar planilha</a>
    <a href="/relatorios" class="btn btn-outline-secondary btn-sm">Voltar</a>
  </div>
</div>

<form method="get" action="/relatorios/doacoes" class="row g-2 mb-3">
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="inicio">De</label>
    <input type="date" class="form-control" id="inicio" name="inicio" value="<%= inicio %>">
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="fim">Até</label>
    <input type="date" class="form-control" id="fim" name="fim" value="<%= fim %>">
  </div>
  <div class="col-8 col-md-3">
    <label class="form-label mb-1" for="tipo">Tipo</label>
    <select class="form-select" id="tipo" name="tipo">
      <option value="">Todos os tipos</option>
      <% tipos.forEach(function (t) { %>
        <option value="<%= t %>" <%= tipo === t ? 'selected' : '' %>><%= rotulos[t] %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-4 col-md-2 d-flex align-items-end">
    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Tipo</th>
        <th class="text-end">Nº doações</th>
        <th class="text-end">Qtd recebida</th>
        <th class="text-end">Doadores</th>
        <th class="text-end">Nº distribuições</th>
        <th class="text-end">Qtd distribuída</th>
        <th class="text-end">Beneficiários</th>
      </tr>
    </thead>
    <tbody>
      <% if (!linhas.length) { %>
        <tr>
          <td colspan="7" class="text-center text-muted">
            Nenhum dado encontrado para os filtros aplicados.
          </td>
        </tr>
      <% } %>
      <% linhas.forEach(function (l) { %>
        <tr>
          <td><%= l.rotulo %></td>
          <td class="text-end"><%= l.num_doacoes %></td>
          <td class="text-end"><%= l.total_recebida %></td>
          <td class="text-end"><%= l.num_doadores %></td>
          <td class="text-end"><%= l.num_distribuicoes %></td>
          <td class="text-end"><%= l.total_distribuida %></td>
          <td class="text-end"><%= l.num_beneficiarios %></td>
        </tr>
      <% }) %>
    </tbody>
    <% if (linhas.length) { %>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td>Total</td>
          <td class="text-end"><%= totais.num_doacoes %></td>
          <td class="text-end"><%= totais.total_recebida %></td>
          <td></td>
          <td class="text-end"><%= totais.num_distribuicoes %></td>
          <td class="text-end"><%= totais.total_distribuida %></td>
          <td></td>
        </tr>
      </tfoot>
    <% } %>
  </table>
</div>

<h2 class="h4 mt-4 mb-2">Detalhamento por item</h2>
<div class="table-responsive">
  <table class="table table-striped table-sm align-middle">
    <thead>
      <tr>
        <th>Tipo</th>
        <th>Item</th>
        <th class="text-end">Nº doações</th>
        <th class="text-end">Qtd recebida</th>
        <th class="text-end">Nº distribuições</th>
        <th class="text-end">Qtd distribuída</th>
      </tr>
    </thead>
    <tbody>
      <% if (!linhasItens.length) { %>
        <tr>
          <td colspan="6" class="text-center text-muted">
            Nenhum dado encontrado para os filtros aplicados.
          </td>
        </tr>
      <% } %>
      <% linhasItens.forEach(function (l) { %>
        <tr>
          <td><%= l.rotulo_tipo %></td>
          <td><%= l.nome_item %></td>
          <td class="text-end"><%= l.num_doacoes %></td>
          <td class="text-end"><%= l.total_recebida %></td>
          <td class="text-end"><%= l.num_distribuicoes %></td>
          <td class="text-end"><%= l.total_distribuida %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
