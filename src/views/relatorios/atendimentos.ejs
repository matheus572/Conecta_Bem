<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Relatório de Atendimentos</h1>
  <div class="d-flex gap-2">
    <a href="/relatorios/atendimentos?formato=pdf<%= qs %>" class="btn btn-outline-danger btn-sm">Exportar PDF</a>
    <a href="/relatorios/atendimentos?formato=xlsx<%= qs %>" class="btn btn-outline-success btn-sm">Exportar planilha</a>
    <a href="/relatorios" class="btn btn-outline-secondary btn-sm">Voltar</a>
  </div>
</div>

<form method="get" action="/relatorios/atendimentos" class="row g-2 mb-3">
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="inicio">De</label>
    <input type="date" class="form-control" id="inicio" name="inicio" value="<%= inicio %>">
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="fim">Até</label>
    <input type="date" class="form-control" id="fim" name="fim" value="<%= fim %>">
  </div>
  <div class="col-4 col-md-2 d-flex align-items-end">
    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Beneficiário</th>
        <th class="text-end">Atendimentos</th>
        <th class="text-end">Distribuições recebidas</th>
        <th class="text-end">Itens recebidos</th>
        <th class="text-end">Matrículas</th>
      </tr>
    </thead>
    <tbody>
      <% if (!linhas.length) { %>
        <tr>
          <td colspan="5" class="text-center text-muted">
            Nenhum dado encontrado para os filtros aplicados.
          </td>
        </tr>
      <% } %>
      <% linhas.forEach(function (l) { %>
        <tr>
          <td><%= l.nome %></td>
          <td class="text-end"><%= l.num_atendimentos %></td>
          <td class="text-end"><%= l.num_distribuicoes %></td>
          <td class="text-end"><%= l.itens_recebidos %></td>
          <td class="text-end"><%= l.num_matriculas %></td>
        </tr>
      <% }) %>
    </tbody>
    <% if (linhas.length) { %>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td>Total</td>
          <td class="text-end"><%= totais.num_atendimentos %></td>
          <td class="text-end"><%= totais.num_distribuicoes %></td>
          <td class="text-end"><%= totais.itens_recebidos %></td>
          <td class="text-end"><%= totais.num_matriculas %></td>
        </tr>
      </tfoot>
    <% } %>
  </table>
</div>
