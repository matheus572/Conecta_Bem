<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Relatório de Campanhas</h1>
  <div class="d-flex gap-2">
    <a href="/relatorios/campanhas?formato=pdf<%= qs %>" class="btn btn-outline-danger btn-sm">Exportar PDF</a>
    <a href="/relatorios/campanhas?formato=xlsx<%= qs %>" class="btn btn-outline-success btn-sm">Exportar planilha</a>
    <a href="/relatorios" class="btn btn-outline-secondary btn-sm">Voltar</a>
  </div>
</div>

<form method="get" action="/relatorios/campanhas" class="row g-2 mb-3">
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="inicio">De</label>
    <input type="date" class="form-control" id="inicio" name="inicio" value="<%= inicio %>">
  </div>
  <div class="col-6 col-md-2">
    <label class="form-label mb-1" for="fim">Até</label>
    <input type="date" class="form-control" id="fim" name="fim" value="<%= fim %>">
  </div>
  <div class="col-8 col-md-3">
    <label class="form-label mb-1" for="status">Status</label>
    <select class="form-select" id="status" name="status">
      <option value="">Todos os status</option>
      <% statusOpcoes.forEach(function (s) { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-4 col-md-2 d-flex align-items-end">
    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Campanha</th>
        <th>Status</th>
        <th>Período</th>
        <th class="text-end">Voluntários</th>
        <th class="text-end">Beneficiários atendidos</th>
        <th class="text-end">Itens distribuídos</th>
      </tr>
    </thead>
    <tbody>
      <% if (!linhas.length) { %>
        <tr>
          <td colspan="6" class="text-center text-muted">
            Nenhum dado encontrado para os filtros aplicados.
          </td>
        </tr>
      <% } %>
      <% linhas.forEach(function (l) { %>
        <tr>
          <td><%= l.titulo %></td>
          <td><%= l.status %></td>
          <td><%= l.periodo %></td>
          <td class="text-end"><%= l.num_voluntarios %></td>
          <td class="text-end"><%= l.beneficiarios_atendidos %></td>
          <td class="text-end"><%= l.itens_distribuidos %></td>
        </tr>
      <% }) %>
    </tbody>
    <% if (linhas.length) { %>
      <tfoot>
        <tr class="table-secondary fw-bold">
          <td>Total</td>
          <td></td>
          <td></td>
          <td></td>
          <td class="text-end"><%= totais.beneficiarios_atendidos %></td>
          <td class="text-end"><%= totais.itens_distribuidos %></td>
        </tr>
      </tfoot>
    <% } %>
  </table>
</div>
