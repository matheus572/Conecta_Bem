<%
  const editando = doador !== null;
  const v = editando ? doador : form;
  const action = editando ? '/doadores/' + doador.id : '/doadores';
  const method = editando ? 'PUT' : 'POST';
%>
<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3"><%= editando ? 'Editar doador' : 'Novo doador' %></h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="<%= action %>" novalidate>
      <input type="hidden" name="_method" value="<%= method %>">

      <div class="mb-3">
        <label for="nome" class="form-label"><%= editando && v.tipo_doador === 'PJ' ? 'Razão social' : 'Nome' %></label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= v.nome || '' %>" required>
      </div>

      <div class="mb-3">
        <label for="tipo_doador" class="form-label">Tipo</label>
        <select class="form-select" id="tipo_doador" name="tipo_doador" required>
          <option value="">Selecione…</option>
          <option value="PF" <%= v.tipo_doador === 'PF' ? 'selected' : '' %>>Pessoa física</option>
          <option value="PJ" <%= v.tipo_doador === 'PJ' ? 'selected' : '' %>>Pessoa jurídica</option>
        </select>
      </div>

      <div class="mb-3">
        <label for="documento" class="form-label">CPF/CNPJ</label>
        <input type="text" class="form-control" id="documento" name="documento" value="<%= v.documento || '' %>" required>
        <div class="form-text">CPF (11 dígitos) para pessoa física; CNPJ (14 dígitos) para pessoa jurídica.</div>
      </div>

      <div class="mb-3">
        <label for="telefone" class="form-label">Telefone</label>
        <input type="text" class="form-control" id="telefone" name="telefone" value="<%= v.telefone || '' %>">
      </div>

      <div class="mb-3">
        <label for="endereco" class="form-label">Endereço</label>
        <input type="text" class="form-control" id="endereco" name="endereco" value="<%= v.endereco || '' %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/doadores" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>