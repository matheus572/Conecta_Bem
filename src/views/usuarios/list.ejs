<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Usuários</h1>
  <a href="/usuarios/novo" class="btn btn-primary">Novo usuário</a>
</div>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Perfil</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (!usuarios.length) { %>
        <tr><td colspan="5" class="text-center text-muted">Nenhum usuário cadastrado.</td></tr>
      <% } %>
      <% usuarios.forEach(function (u) { %>
        <tr>
          <td><%= u.nome %></td>
          <td><%= u.email %></td>
          <td><%= u.perfil === 'ADMINISTRADOR' ? 'Administrador' : 'Colaborador' %></td>
          <td>
            <span class="badge <%= u.ativo ? 'bg-success' : 'bg-secondary' %>"><%= u.ativo ? 'Ativo' : 'Inativo' %></span>
          </td>
          <td class="text-end text-nowrap">
            <a href="/usuarios/<%= u.id %>/editar" class="btn btn-sm btn-outline-secondary">Editar</a>
            <form method="post" action="/usuarios/<%= u.id %>/ativo" class="d-inline">
              <button type="submit" name="ativo" value="<%= u.ativo ? '0' : '1' %>" class="btn btn-sm btn-outline-secondary">
                <%= u.ativo ? 'Desativar' : 'Reativar' %>
              </button>
            </form>
            <form method="post" action="/usuarios/<%= u.id %>?_method=DELETE" class="d-inline"
              onsubmit="return confirm('Excluir este usuário?')">
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>