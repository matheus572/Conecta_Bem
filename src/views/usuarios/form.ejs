<%
  const editando = usuario !== null;
  const v = editando ? usuario : form;
  const action = editando ? '/usuarios/' + usuario.id : '/usuarios';
  const method = editando ? 'PUT' : 'POST';
%>
<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3"><%= editando ? 'Editar usuário' : 'Novo usuário' %></h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="<%= action %>" novalidate>
      <input type="hidden" name="_method" value="<%= method %>">

      <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= v.nome || '' %>" required>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">E-mail</label>
        <input type="email" class="form-control" id="email" name="email" value="<%= v.email || '' %>" required>
      </div>

      <% if (!editando) { %>
        <div class="mb-3">
          <label for="senha" class="form-label">Senha</label>
          <input type="password" class="form-control" id="senha" name="senha" required>
          <div class="form-text">Mínimo de 8 caracteres, com letras e números.</div>
        </div>
      <% } %>

      <div class="mb-3">
        <label for="perfil" class="form-label">Perfil</label>
        <select class="form-select" id="perfil" name="perfil" required>
          <option value="">Selecione…</option>
          <option value="COLABORADOR" <%= v.perfil === 'COLABORADOR' ? 'selected' : '' %>>Colaborador</option>
          <option value="ADMINISTRADOR" <%= v.perfil === 'ADMINISTRADOR' ? 'selected' : '' %>>Administrador</option>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/usuarios" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>