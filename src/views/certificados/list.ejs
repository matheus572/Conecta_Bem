<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Certificados</h1>
</div>

<p class="text-muted">Selecione a turma para listar os alunos aptos e emitir os certificados (RF_35).</p>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Curso</th>
        <th>Período</th>
        <th>Horário</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% if (!turmas.length) { %>
        <tr><td colspan="5" class="text-center text-muted">Nenhuma turma cadastrada.</td></tr>
      <% } %>
      <% turmas.forEach(function (t) { %>
        <tr>
          <td><%= t.curso_nome %></td>
          <td><%= t.periodo %></td>
          <td><%= t.horario %> (<%= t.dias_semana %>)</td>
          <td>
            <span class="badge <%= t.status === 'ATIVA' ? 'bg-success' : (t.status === 'ENCERRADA' ? 'bg-dark' : 'bg-secondary') %>">
              <%= rotulosStatusTurma[t.status] %>
            </span>
          </td>
          <td class="text-end">
            <a href="/certificados/turmas/<%= t.id %>" class="btn btn-sm btn-outline-primary">Alunos</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
