<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3">Registrar distribuição</h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="/doacoes/distribuicoes" novalidate>
      <div class="mb-3">
        <label for="beneficiario_id" class="form-label">Beneficiário</label>
        <select class="form-select" id="beneficiario_id" name="beneficiario_id" required>
          <option value="">Selecione…</option>
          <% beneficiarios.forEach(function (b) { %>
            <option value="<%= b.id %>" <%= String(form.beneficiario_id) === String(b.id) ? 'selected' : '' %>><%= b.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label for="item_id" class="form-label">Item</label>
        <select class="form-select" id="item_id" name="item_id" required>
          <option value="">Selecione…</option>
          <% itens.forEach(function (grupo) { %>
            <optgroup label="<%= grupo.rotulo %>">
              <% grupo.itens.forEach(function (item) { %>
                <option value="<%= item.id %>" <%= String(form.item_id) === String(item.id) ? 'selected' : '' %>>
                  <%= item.nome_item %> (<%= item.unidade %>)
                </option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label for="quantidade" class="form-label">Quantidade</label>
        <input type="number" step="0.01" min="0.01" class="form-control" id="quantidade" name="quantidade" value="<%= form.quantidade || '' %>" required>
      </div>

      <div class="mb-3">
        <label for="data_distribuicao" class="form-label">Data</label>
        <input type="date" class="form-control" id="data_distribuicao" name="data_distribuicao" value="<%= form.data_distribuicao || '' %>">
      </div>

      <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <input type="text" class="form-control" id="descricao" name="descricao" value="<%= form.descricao || '' %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/doacoes/distribuicoes" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>