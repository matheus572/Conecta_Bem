<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3">Registrar doação</h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="/doacoes" novalidate>
      <div class="mb-3">
        <label for="doador_id" class="form-label">Doador</label>
        <select class="form-select" id="doador_id" name="doador_id" required>
          <option value="">Selecione…</option>
          <% doadores.forEach(function (d) { %>
            <option value="<%= d.id %>" <%= String(form.doador_id) === String(d.id) ? 'selected' : '' %>><%= d.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3">
        <label for="nome_item" class="form-label">Item</label>
        <input type="text" class="form-control" id="nome_item" name="nome_item" maxlength="120"
          list="lista-itens" value="<%= form.nome_item || '' %>"
          placeholder="Digite o nome do item (ex.: Leite 1L)" required autocomplete="off">
        <datalist id="lista-itens">
          <% itens.forEach(function (item) { %>
            <option value="<%= item.nome_item %>" data-tipo="<%= item.tipo_doacao %>" data-unidade="<%= item.unidade %>"></option>
          <% }) %>
        </datalist>
        <div id="item-aviso" class="form-text"></div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-sm-6">
          <label for="tipo_doacao" class="form-label">Categoria</label>
          <select class="form-select" id="tipo_doacao" name="tipo_doacao" required>
            <option value="">Selecione…</option>
            <% tipos.forEach(function (t) { %>
              <option value="<%= t.valor %>" <%= form.tipo_doacao === t.valor ? 'selected' : '' %>><%= t.rotulo %></option>
            <% }) %>
          </select>
        </div>
        <div class="mb-3 col-12 col-sm-6">
          <label for="unidade" class="form-label">Unidade</label>
          <select class="form-select" id="unidade" name="unidade">
            <% unidades.forEach(function (u) { %>
              <option value="<%= u %>" <%= (form.unidade || 'UN') === u ? 'selected' : '' %>><%= u %></option>
            <% }) %>
          </select>
          <div class="form-text">Só é usada ao criar um item novo; para itens existentes, mantém-se a unidade do cadastro.</div>
        </div>
      </div>

      <script>
        // UX: ao digitar um nome que casa com um item já cadastrado (mesma
        // grafia ignorando caixa/espaços/acentos — coerente com a collation
        // utf8mb4_unicode_ci do banco), preenche e trava categoria/unidade.
        // O SERVIDOR é a fonte da verdade: lá tudo é validado de novo.
        (function () {
          var input = document.getElementById('nome_item');
          var aviso = document.getElementById('item-aviso');
          var tipoSel = document.getElementById('tipo_doacao');
          var unSel = document.getElementById('unidade');
          var opcoes = Array.prototype.slice.call(
            document.querySelectorAll('#lista-itens option'),
          );

          function norm(txt) {
            return (txt || '')
              .trim()
              .replace(/\s+/g, ' ')
              .toLowerCase()
              .normalize('NFD')
              .replace(/[̀-ͯ]/g, '');
          }

          function travar(camada) {
            // `disabled` impede o envio; 'pointer-events: none' + tabindex
            // trava visualmente, mas o valor continua sendo enviado.
            [tipoSel, unSel].forEach(function (el) {
              el.classList.toggle('pe-none', camada);
              el.setAttribute('aria-readonly', camada ? 'true' : 'false');
              el.tabIndex = camada ? -1 : 0;
            });
          }

          function atualizarAviso() {
            var nome = norm(input.value);
            var encontrado = opcoes.find(function (o) {
              return norm(o.value) === nome;
            });
            if (!nome) {
              aviso.textContent = '';
              travar(false);
              return;
            }
            if (encontrado) {
              tipoSel.value = encontrado.dataset.tipo;
              unSel.value = encontrado.dataset.unidade;
              travar(true);
              aviso.textContent = 'Item já cadastrado: a quantidade será somada ao saldo atual.';
            } else {
              travar(false);
              aviso.textContent = 'Novo item: será criado ao salvar.';
            }
          }

          input.addEventListener('input', atualizarAviso);
          atualizarAviso();
        })();
      </script>

      <div class="mb-3">
        <label for="quantidade" class="form-label">Quantidade</label>
        <input type="number" step="0.01" min="0.01" class="form-control" id="quantidade" name="quantidade" value="<%= form.quantidade || '' %>" required>
      </div>

      <div class="mb-3">
        <label for="data_doacao" class="form-label">Data</label>
        <input type="date" class="form-control" id="data_doacao" name="data_doacao" value="<%= form.data_doacao || '' %>">
      </div>

      <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <input type="text" class="form-control" id="descricao" name="descricao" value="<%= form.descricao || '' %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/doacoes" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>