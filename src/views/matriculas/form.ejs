<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3">Realizar matrícula</h1>

    <div class="card mb-3">
      <div class="card-body">
        <p class="mb-1"><strong>Curso:</strong> <%= turma.curso_nome %></p>
        <p class="mb-1"><strong>Turma:</strong> <%= turma.periodo %> — <%= turma.horario %> (<%= turma.dias_semana %>)</p>
        <p class="mb-0"><strong>Capacidade:</strong> <%= turma.capacidade %> vaga(s)</p>
      </div>
    </div>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="/matriculas" novalidate>
      <input type="hidden" name="turma_id" value="<%= turma.id %>">

      <div class="mb-3">
        <label for="beneficiario_id" class="form-label">Beneficiário</label>
        <select class="form-select" id="beneficiario_id" name="beneficiario_id" required>
          <option value="">— Selecione —</option>
          <% beneficiarios.forEach(function (b) { %>
            <option value="<%= b.id %>" <%= Number(form.beneficiario_id) === b.id ? 'selected' : '' %>><%= b.nome %> (CPF: <%= b.cpf %>)</option>
          <% }) %>
        </select>
        <div class="form-text">A vaga só é confirmada se houver disponibilidade na turma (RN02).</div>
      </div>

      <div class="mb-3">
        <label for="data_matricula" class="form-label">Data da matrícula</label>
        <input type="date" class="form-control" id="data_matricula" name="data_matricula"
          value="<%= form.data_matricula || new Date().toISOString().slice(0, 10) %>">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Confirmar matrícula</button>
        <a href="/cursos/turmas/<%= turma.id %>" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
