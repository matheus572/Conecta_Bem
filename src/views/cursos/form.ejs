<%
  const editando = curso !== null;
  const c = editando ? curso : form;
  const action = editando ? '/cursos/' + curso.id : '/cursos';
  const method = editando ? 'PUT' : 'POST';
%>
<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3"><%= editando ? 'Editar curso' : 'Novo curso' %></h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="<%= action %>" novalidate>
      <input type="hidden" name="_method" value="<%= method %>">

      <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <input type="text" class="form-control" id="nome" name="nome" value="<%= c.nome || '' %>" required>
      </div>

      <div class="mb-3">
        <label for="descricao" class="form-label">Descrição</label>
        <textarea class="form-control" id="descricao" name="descricao" rows="3"><%= c.descricao || '' %></textarea>
      </div>

      <div class="row">
        <div class="mb-3 col-6">
          <label for="carga_horaria" class="form-label">Carga horária (horas)</label>
          <input type="number" class="form-control" id="carga_horaria" name="carga_horaria" min="1"
            value="<%= c.carga_horaria || '' %>" required>
        </div>
        <div class="mb-3 col-6">
          <label for="quantidade_vagas" class="form-label">Quantidade de vagas</label>
          <input type="number" class="form-control" id="quantidade_vagas" name="quantidade_vagas" min="1"
            value="<%= c.quantidade_vagas || '' %>" required>
          <div class="form-text">Total do curso; o controle efetivo de vagas é por turma (capacidade).</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="status" class="form-label">Status</label>
        <select class="form-select" id="status" name="status">
          <% statusCurso.forEach(function (s) { %>
            <option value="<%= s %>" <%= (c.status || 'ATIVO') === s ? 'selected' : '' %>><%= rotulosStatus[s] %></option>
          <% }) %>
        </select>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/cursos" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
