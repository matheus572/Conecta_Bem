<div class="row justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <h1 class="h3 mb-3"><%= item ? 'Editar item' : 'Novo item' %></h1>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>

    <form method="post" action="<%= item ? `/estoque/itens/${item.id}?_method=PUT` : '/estoque/itens' %>" novalidate>
      <% if (item) { %><input type="hidden" name="_method" value="PUT"><% } %>

      <div class="mb-3">
        <label for="nome_item" class="form-label">Nome do item</label>
        <input type="text" class="form-control" id="nome_item" name="nome_item" maxlength="120"
          value="<%= form.nome_item || '' %>" placeholder="Ex.: Leite 1L, Cesta básica" required autofocus>
      </div>

      <% if (item) { %>
        <div class="mb-3">
          <label class="form-label">Tipo</label>
          <input type="text" class="form-control" value="<%= rotulos[item.tipo_doacao] || item.tipo_doacao %>" disabled>
          <div class="form-text">O tipo não pode ser alterado após a criação (preserva os saldos por tipo).</div>
        </div>
      <% } else { %>
        <div class="mb-3">
          <label for="tipo_doacao" class="form-label">Tipo</label>
          <select class="form-select" id="tipo_doacao" name="tipo_doacao" required>
            <option value="">Selecione…</option>
            <% tipos.forEach(function (t) { %>
              <option value="<%= t.valor %>" <%= form.tipo_doacao === t.valor ? 'selected' : '' %>><%= t.rotulo %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <div class="mb-3">
        <label for="unidade" class="form-label">Unidade de medida</label>
        <input type="text" class="form-control" id="unidade" name="unidade" maxlength="20"
          value="<%= form.unidade || 'UN' %>" placeholder="Ex.: UN, L, KG">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/estoque" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>
