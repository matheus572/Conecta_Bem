<div class="row justify-content-center">
  <div class="col-12 col-sm-8 col-md-6 col-lg-5">
    <div class="card mt-4 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">Recuperar senha</h1>

        <% if (typeof mensagem !== 'undefined' && mensagem) { %>
          <div class="alert alert-info"><%= mensagem %></div>
          <p class="text-muted small mb-0">Verifique também a caixa de spam.</p>
        <% } else { %>
          <p class="text-muted">Informe o e-mail cadastrado. Enviaremos um link para redefinir sua senha.</p>
          <form method="post" action="/forgot-password" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label">E-mail</label>
              <input type="email" class="form-control" id="email" name="email" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary w-100">Enviar link de recuperação</button>
          </form>
        <% } %>

        <p class="text-center small mt-3 mb-0">
          <a href="/login">Voltar ao login</a>
        </p>
      </div>
    </div>
  </div>
</div>
