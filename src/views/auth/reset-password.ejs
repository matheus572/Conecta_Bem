<div class="row justify-content-center">
  <div class="col-12 col-sm-8 col-md-6 col-lg-5">
    <div class="card mt-4 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">Redefinir senha</h1>

        <% if (tokenInvalido) { %>
          <div class="alert alert-danger">
            Link de recuperação inválido ou expirado. Solicite um novo link.
          </div>
          <a href="/forgot-password" class="btn btn-primary w-100">Solicitar novo link</a>
        <% } else { %>
          <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alert alert-danger"><%= erro %></div>
          <% } %>
          <form method="post" action="/reset-password" novalidate>
            <input type="hidden" name="token" value="<%= token %>">
            <div class="mb-3">
              <label for="senha" class="form-label">Nova senha</label>
              <input type="password" class="form-control" id="senha" name="senha" required autofocus>
              <div class="form-text">Mínimo de 8 caracteres, com letras e números.</div>
            </div>
            <div class="mb-3">
              <label for="senha_confirmacao" class="form-label">Confirmar nova senha</label>
              <input type="password" class="form-control" id="senha_confirmacao" name="senha_confirmacao" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Redefinir senha</button>
          </form>
        <% } %>

        <p class="text-center small mt-3 mb-0">
          <a href="/login">Voltar ao login</a>
        </p>
      </div>
    </div>
  </div>
</div>
