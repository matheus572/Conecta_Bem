<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 text-center">
      <h1 class="display-5 mb-3">Bem-vindo, <%= currentUser.nome %></h1>
      <p class="lead text-muted mb-4">
        Associação Assistencial Projeto Corrente do Bem
      </p>
      <div class="d-grid gap-2 d-sm-flex justify-content-center">
        <a href="/beneficiarios" class="btn btn-primary">Beneficiários</a>
        <a href="/doadores" class="btn btn-outline-primary">Doadores</a>
        <% if (currentUser.perfil === 'ADMINISTRADOR') { %>
          <a href="/usuarios" class="btn btn-outline-primary">Usuários</a>
        <% } %>
      </div>
      <p class="small text-muted mt-4">
        Doações, voluntários, campanhas e cursos serão adicionados nas próximas sprints.
      </p>
    </div>
  </div>
</main>